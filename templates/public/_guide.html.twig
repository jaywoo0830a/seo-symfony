{# Guide — BodyTemplate::Guide. 미니멀 prose 레이아웃. #}

<main class="page page--narrow">
    {% if crumbs is not empty %}
        <nav class="crumbs" aria-label="Breadcrumb">
            {% for crumb in crumbs %}
                {% if crumb.current %}
                    <span class="crumbs__current" aria-current="page">{{ crumb.label }}</span>
                {% else %}
                    <a class="crumbs__link" href="{{ crumb.url }}">{{ crumb.label }}</a>
                    <span class="crumbs__sep" aria-hidden="true">›</span>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}

    <article class="article">
        <header class="article__header">
            <h1>{{ h1 }}</h1>
            {% if node.introText %}<p class="article__lede">{{ node.introText }}</p>{% endif %}
            {% if node.author %}
                <p class="article__byline">
                    <strong>{{ node.author.realName }}</strong>
                    {% if node.lastReviewAt %} · 최근 검토 {{ node.lastReviewAt|date('Y-m-d') }}{% endif %}
                </p>
            {% endif %}
        </header>

        {% if body_html %}<div class="article__body">{{ body_html|raw }}</div>{% endif %}

        {% if byKind.faq is not empty %}
            <section>
                <h2>자주 묻는 질문</h2>
                {% for dp in byKind.faq %}
                    <details>
                        <summary>{{ dp.title }}</summary>
                        <div>{% include 'public/_value.html.twig' with { value: dp.value } only %}</div>
                    </details>
                {% endfor %}
            </section>
        {% endif %}

        {% set _cta = cta('final', template) %}
        {% if _cta %}
            <section class="cta-block">
                {% include 'public/_partials/cta/_block_body.html.twig' with { cta: _cta } only %}
            </section>
        {% endif %}
    </article>
</main>
