{% extends 'public/layout.html.twig' %}

{% set abs_url = absolute_url(url) %}
{% set region_label = node.region ? node.region.name : '' %}
{% set theme_label = node.theme.name %}
{% set keyword = (region_label ~ ' ' ~ theme_label)|trim %}
{% set is_guide = template.isGuide() %}

{% block title %}{{ keyword }} 강사 추천 — 전화 한 통이면 충분{% endblock %}
{% block description %}{{ node.introText|default('')|striptags|slice(0, 160) }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ abs_url }}">{% endblock %}

{% block content %}
    {% if is_guide %}
        {% include 'public/_guide.html.twig' %}
        <script type="application/ld+json">{{ json_ld|raw }}</script>
        <script type="application/ld+json">{{ breadcrumbs_jsonld|raw }}</script>
    {% else %}
    {# ─── BREADCRUMB ─────────────────────────────────────────────── #}
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
            {% for crumb in crumbs %}
                <li class="breadcrumb__item">
                    {% if crumb.current %}
                        <span class="breadcrumb__current" aria-current="page">{{ crumb.label }}</span>
                    {% else %}
                        <a class="breadcrumb__link" href="{{ crumb.url }}">{{ crumb.label }}</a>
                        <span class="breadcrumb__sep" aria-hidden="true">›</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>

    {# ─── HERO ───────────────────────────────────────────────────── #}
    <section class="hero">
        <div class="hero__inner">
            <div>
                <span class="hero__eyebrow">📍 {{ keyword }} 매칭</span>
                <h1 class="hero__title">
                    {% if region_label %}<span class="hero__highlight">{{ region_label }}</span>에서{% endif %}
                    {{ theme_label }}<br>
                    가장 빠르게 시작하는 법
                </h1>
                {% if node.introText %}
                    <p class="hero__lede">{{ node.introText }}</p>
                {% endif %}
                <div class="hero__actions">
                    <a class="cta cta--primary cta--lg" href="{{ brand_phone_link() }}">
                        <span class="cta__icon" aria-hidden="true">📞</span>
                        <span>{{ brand_phone() }} 지금 전화하기</span>
                    </a>
                    <span class="hero__assurance">5분 안에 강사 후보 3명 추천</span>
                </div>
            </div>
            {% if byKind.quantitative is not empty %}
                <div class="hero__stats">
                    {% for dp in byKind.quantitative|slice(0, 3) %}
                        <div class="hero__stat">
                            <div class="hero__stat-figure">
                                {%- if dp.value is iterable -%}
                                    {{ dp.value|length }}
                                {%- else -%}
                                    {{ dp.value }}
                                {%- endif -%}
                            </div>
                            <span class="hero__stat-label">{{ dp.title }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {# ─── 왜 우리인가 (3 features) ───────────────────────────────── #}
    <section class="section">
        <div class="section__inner">
            <header class="section__header">
                <span class="section__eyebrow">왜 우리인가</span>
                <h2 class="section__title">{{ keyword }}, 검증된 사람만</h2>
                <p class="section__lede">{{ region_label ?: '전국' }} 안에서 학력·자격증·경력 모두 확인된 강사만 매칭합니다.</p>
            </header>
            <div class="feature-grid">
                <div class="feature-grid__card">
                    <div class="feature-grid__icon" aria-hidden="true">✓</div>
                    <h3 class="feature-grid__title">신원·자격 100% 검증</h3>
                    <p class="feature-grid__body">학력 증빙·자격증·신분증을 모두 확인하며, 인증 마크가 표시된 강사만 매칭됩니다.</p>
                </div>
                <div class="feature-grid__card">
                    <div class="feature-grid__icon" aria-hidden="true">⚡</div>
                    <h3 class="feature-grid__title">5분 매칭, 비용 0원</h3>
                    <p class="feature-grid__body">전화 한 통으로 지역·과목·예산을 알려주시면 후보 3명을 즉시 추천드립니다. 매칭 비용 없음.</p>
                </div>
                <div class="feature-grid__card">
                    <div class="feature-grid__icon" aria-hidden="true">🛡</div>
                    <h3 class="feature-grid__title">맞지 않으면 환불</h3>
                    <p class="feature-grid__body">첫 수업 후 마음에 들지 않으면 100% 환불해드립니다. 후속 수업에 부담 없도록.</p>
                </div>
            </div>
        </div>
    </section>

    {# ─── 비교 (이웃 지역 대비 우위) ────────────────────────────── #}
    {% if byKind.comparison is not empty %}
        <section class="section section--alt">
            <div class="section__inner section__inner--narrow">
                <header class="section__header">
                    <span class="section__eyebrow">{{ region_label ?: '시장' }} 인사이트</span>
                    <h2 class="section__title">왜 {{ keyword }}가 다른가</h2>
                </header>
                <div class="callout-stack">
                    {% for dp in byKind.comparison %}
                        <div class="callout">
                            <span class="callout__title">{{ dp.title }}</span>
                            <p class="callout__quote">
                                {%- if dp.value is iterable %}{{ dp.value|join(', ') }}{% else %}{{ dp.value|raw }}{% endif -%}
                            </p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ─── 제공 항목 (qualitative DataPoint들 — listing) ────────── #}
    {% if byKind.qualitative is not empty %}
        <section class="section">
            <div class="section__inner">
                <header class="section__header">
                    <span class="section__eyebrow">제공 범위</span>
                    <h2 class="section__title">{{ keyword }}에서 다루는 것</h2>
                </header>
                <ul class="listing">
                    {% for dp in byKind.qualitative %}
                        <li class="listing__item">
                            <span class="listing__title">{{ dp.title }}</span>
                            <div class="listing__body">
                                {%- if dp.value is iterable -%}
                                    {%- set first_key = dp.value|keys|first -%}
                                    {%- if first_key is same as(0) -%}
                                        {# list — tag chips #}
                                        <ul class="listing__tags">
                                            {% for v in dp.value %}
                                                <li class="listing__tag">{{ v }}</li>
                                            {% endfor %}
                                        </ul>
                                    {%- else -%}
                                        {# associative — pair list #}
                                        <dl class="listing__pairs">
                                            {% for k, v in dp.value %}
                                                <div class="listing__pair">
                                                    <span class="listing__pair-key">{{ k }}</span>
                                                    <span class="listing__pair-val">{{ v is iterable ? v|join(', ') : v }}</span>
                                                </div>
                                            {% endfor %}
                                        </dl>
                                    {%- endif -%}
                                {%- else -%}
                                    {{ dp.value }}
                                {%- endif -%}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}

    {# ─── 자식 테마 카드 (예: /guides/ → 가이드 3종) ────────────── #}
    {% if theme_children is not empty %}
        <section class="section">
            <div class="section__inner">
                <header class="section__header">
                    <span class="section__eyebrow">읽을거리</span>
                    <h2 class="section__title">{{ theme_label }} 카테고리의 페이지</h2>
                </header>
                <ul class="theme-children">
                    {% for child in theme_children %}
                        <li class="theme-children__item">
                            <a class="theme-children__link" href="{{ urls.build(child) }}">
                                <span class="theme-children__title">{{ child.theme.name }}</span>
                                {% if child.introText %}
                                    <span class="theme-children__lede">{{ child.introText|striptags|slice(0, 110) }}…</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}

    {# ─── FAQ ────────────────────────────────────────────────────── #}
    {% if byKind.faq is not empty %}
        <section class="section section--alt">
            <div class="section__inner">
                <header class="section__header">
                    <span class="section__eyebrow">자주 묻는 질문</span>
                    <h2 class="section__title">전화 전 궁금하신 것</h2>
                </header>
                <div class="faq">
                    {% for dp in byKind.faq %}
                        <details class="faq__item">
                            <summary class="faq__question">{{ dp.title }}</summary>
                            <div class="faq__answer">
                                {%- if dp.value is iterable %}{{ dp.value|join(', ') }}{% else %}{{ dp.value }}{% endif -%}
                            </div>
                        </details>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ─── 마지막 CTA ────────────────────────────────────────────── #}
    <section class="final-cta">
        <div class="final-cta__inner">
            <span class="final-cta__eyebrow">{{ region_label ?: '전국' }} {{ theme_label }} 매칭</span>
            <h2 class="final-cta__title">전화 한 통이면 끝납니다</h2>
            <p class="final-cta__lede">
                지역·과목·예산을 알려주시면 검증된 강사 후보 3명을 5분 안에 추천드립니다. 통화는 무료, 매칭은 비용 없음.
            </p>
            <div class="final-cta__phone-block">
                <a class="final-cta__phone-link" href="{{ brand_phone_link() }}">
                    <span class="final-cta__phone-icon" aria-hidden="true">📞</span>
                    <span>{{ brand_phone() }}</span>
                </a>
                <span class="final-cta__hint">{{ brand_phone_hours() }}</span>
            </div>
            <div class="final-cta__assurances">
                <span class="final-cta__assurance">상담 비용 없음</span>
                <span class="final-cta__assurance">매칭 후 환불 보장</span>
                <span class="final-cta__assurance">강사 신원 100% 검증</span>
            </div>
        </div>
    </section>

    {# JSON-LD (서버 사이드 생성, 실행 JS 아님) — Article + BreadcrumbList #}
    <script type="application/ld+json">{{ json_ld|raw }}</script>
    <script type="application/ld+json">{{ breadcrumbs_jsonld|raw }}</script>
    {% endif %}
{% endblock %}
