{% extends 'public/layout.html.twig' %}

{% block title %}{{ brand_public_name() }}{% endblock %}
{% block description %}{{ brand_public_name() }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('public_home') }}">{% endblock %}

{% block content %}
    <main class="page page--narrow">
        <h1>{{ brand_public_name() }}</h1>
        <p class="lede">programmatic SEO 빈 스타터입니다. 어드민에서 첫 테마와 콘텐츠 노드를 추가하세요.</p>

        {% if themes is not empty %}
            <ul class="link-list">
                {% for theme in themes %}
                    <li><a href="/{{ theme.slug }}/">{{ theme.name }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}

        <p><a href="{{ path('admin_dashboard') }}">어드민 →</a></p>
    </main>
{% endblock %}
