{# 학습 콘텐츠(contents) 매트릭스 — 모든 /contents/*/* 지역 페이지의 셸.

   tutoring과 academy와 또 다른 톤:
   - 상품 = 디지털 콘텐츠 (오프라인 매칭/시설 아님)
   - 사용자 의도 = 체험·구독 결정
   - 강조 = 학습 경로 / 콘텐츠 깊이 / 학년별 커버리지
   - hero = 다크 톤 + 카탈로그 카드 그리드 (과외=그라디언트, 학원=split 데이터)
   - CTA 톤 = "체험 시작" / "콘텐츠 둘러보기"
#}

<div class="matrix--contents">
    {% include 'public/_partials/breadcrumb.html.twig' %}

    {# ─── 다크 hero — 디지털 톤 강조 ─────────────────────────── #}
    <section class="contents-hero">
        <div class="contents-hero__inner">
            <span class="contents-hero__eyebrow">📚 {{ keyword }} 학습 콘텐츠</span>
            <h1 class="contents-hero__title">
                {%- if region_label %}{{ region_label }} 학생을 위한{% else %}전국 학생을 위한{% endif %}<br>
                <span class="contents-hero__highlight">{{ theme_label }}</span>
            </h1>
            {% if node.introText %}
                <p class="contents-hero__lede">{{ node.introText }}</p>
            {% endif %}

            {% if byKind.quantitative is not empty %}
                <ul class="contents-hero__metrics">
                    {% for dp in byKind.quantitative|slice(0, 3) %}
                        <li>
                            <span class="contents-hero__metric-figure">
                                {%- if dp.value is iterable %}{{ dp.value|length }}{% else %}{{ dp.value }}{% endif -%}
                            </span>
                            <span class="contents-hero__metric-label">{{ dp.title }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>

    {# ─── 학습 경로 / 핵심 콘텐츠 — 과목 분포 listing 활용 ──── #}
    {% if byKind.qualitative is not empty %}
        <section class="contents-tracks">
            <div class="contents-tracks__inner">
                <header class="contents-tracks__header">
                    <span class="contents-tracks__eyebrow">학습 경로</span>
                    <h2 class="contents-tracks__title">{{ keyword }}에서 다루는 영역</h2>
                </header>
                <div class="contents-tracks__grid">
                    {% for dp in byKind.qualitative %}
                        <article class="contents-track">
                            <h3 class="contents-track__title">{{ dp.title }}</h3>
                            <div class="contents-track__body">
                                {%- if dp.value is iterable -%}
                                    {%- set first_key = dp.value|keys|first -%}
                                    {%- if first_key is same as(0) -%}
                                        <ul class="contents-track__chips">
                                            {% for v in dp.value %}<li>{{ v }}</li>{% endfor %}
                                        </ul>
                                    {%- else -%}
                                        <dl class="contents-track__pairs">
                                            {% for k, v in dp.value %}
                                                <dt>{{ k }}</dt>
                                                <dd>{{ v is iterable ? v|join(', ') : v }}</dd>
                                            {% endfor %}
                                        </dl>
                                    {%- endif -%}
                                {%- else -%}
                                    {{ dp.value }}
                                {%- endif -%}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ─── 콘텐츠 차별점 (comparison) — 미니 인사이트 톤 ───── #}
    {% include 'public/_partials/callouts.html.twig' with {
        items: byKind.comparison,
        eyebrow: '콘텐츠 인사이트',
        title: keyword ~ '의 학습 효과',
    } only %}

    {# ─── FAQ ────────────────────────────────────────────────── #}
    {% include 'public/_partials/faq.html.twig' with {
        items: byKind.faq,
        eyebrow: '체험 전 확인',
        title: keyword ~ ' 자주 묻는 질문',
        alt: false,
    } only %}

    {# ─── CTA — 디지털 상품 톤. "체험 시작" 느낌. ───────────── #}
    <section class="contents-cta">
        <div class="contents-cta__inner">
            <span class="contents-cta__eyebrow">무료 체험 안내</span>
            <h2 class="contents-cta__title">먼저 둘러보고 결정하세요</h2>
            <p class="contents-cta__lede">학년·과목별 추천 콘텐츠와 학습 경로를 운영팀이 안내드립니다. 체험 7일 후 결제, 부담 없이 시작.</p>
            <a class="contents-cta__phone" href="{{ brand_phone_link() }}">
                <span aria-hidden="true">📞</span>
                <span>{{ brand_phone() }}</span>
            </a>
        </div>
    </section>
</div>
