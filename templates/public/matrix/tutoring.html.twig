{# 매트릭스 본체 — 지역 페이지(시도/시군구/동) + 오버라이드 없는 테마 허브.

   이 파일이 모든 매트릭스 페이지의 외형을 결정합니다.
   파셜 조합·순서·문구를 바꾸면 *모든 매트릭스 페이지에 일괄 반영*됩니다.
   균일성이 SEO 자산이므로, 변형은 데이터(DataPoint)에서만 줘야 합니다.

   사용 가능한 컨텍스트 (PublicNodeController가 주입):
     node, byKind (quantitative/qualitative/comparison/case/faq),
     theme_children, theme_siblings, urls, crumbs,
     region_label, theme_label, keyword (node.html.twig에서 set)
#}

{% include 'public/_partials/breadcrumb.html.twig' %}

{% set _hero_stats = [] %}
{% for dp in byKind.quantitative|slice(0, 3) %}
    {% set _hero_stats = _hero_stats|merge([{
        figure: dp.value is iterable ? dp.value|length : dp.value,
        label: dp.title,
    }]) %}
{% endfor %}

{% include 'public/_partials/hero.html.twig' with {
    eyebrow: '📍 ' ~ keyword ~ ' 매칭',
    title_main: region_label ? '' : theme_label,
    title_highlight: region_label,
    title_tail: region_label ? '에서 ' ~ theme_label ~ ' 가장 빠르게 시작하는 법' : '가장 빠르게 시작하는 법',
    lede: node.introText,
    assurance: '5분 안에 강사 후보 3명 추천',
    stats: _hero_stats,
    body_template: template,
} only %}

{% include 'public/_partials/feature_grid.html.twig' with {
    title: keyword ~ ', 검증된 사람만',
    lede: (region_label ?: '전국') ~ ' 안에서 학력·자격증·경력 모두 확인된 강사만 매칭합니다.',
} only %}

{% include 'public/_partials/callouts.html.twig' with {
    items: byKind.comparison,
    eyebrow: (region_label ?: '시장') ~ ' 인사이트',
    title: '왜 ' ~ keyword ~ '가 다른가',
} only %}

{% include 'public/_partials/listing.html.twig' with {
    items: byKind.qualitative,
    title: keyword ~ '에서 다루는 것',
} only %}

{% include 'public/_partials/theme_children.html.twig' with {
    items: theme_children,
    urls: urls,
    title: theme_label ~ ' 카테고리의 페이지',
} only %}

{% include 'public/_partials/faq.html.twig' with {items: byKind.faq} only %}

{% include 'public/_partials/final_cta.html.twig' with {
    eyebrow: (region_label ?: '전국') ~ ' ' ~ theme_label ~ ' 매칭',
    body_template: template,
} only %}
