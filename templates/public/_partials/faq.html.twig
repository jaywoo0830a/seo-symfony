{# FAQ — args: items, eyebrow, title, alt #}
{% set items = items is defined ? items : [] %}
{% set eyebrow = eyebrow is defined ? eyebrow : '자주 묻는 질문' %}
{% set title = title is defined ? title : '전화 전 궁금하신 것' %}
{% set alt = alt is defined ? alt : true %}

{% if items is not empty %}
    <section class="section{% if alt %} section--alt{% endif %}">
        <div class="section__inner">
            <header class="section__header">
                <span class="section__eyebrow">{{ eyebrow }}</span>
                <h2 class="section__title">{{ title }}</h2>
            </header>
            <div class="faq">
                {% for dp in items %}
                    <details class="faq__item">
                        <summary class="faq__question">{{ dp.title }}</summary>
                        <div class="faq__answer">
                            {%- if dp.value is iterable %}{{ dp.value|join(', ') }}{% else %}{{ dp.value }}{% endif -%}
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
