{# Theme-tree children cards — args: items, urls, eyebrow, title #}
{% set items = items is defined ? items : [] %}
{% set urls = urls is defined ? urls : null %}
{% set eyebrow = eyebrow is defined ? eyebrow : '읽을거리' %}
{% set title = title is defined ? title : '이 카테고리의 페이지' %}

{% if items is not empty and urls %}
    <section class="section">
        <div class="section__inner">
            <header class="section__header">
                <span class="section__eyebrow">{{ eyebrow }}</span>
                <h2 class="section__title">{{ title }}</h2>
            </header>
            <ul class="theme-children">
                {% for child in items %}
                    <li class="theme-children__item">
                        <a class="theme-children__link" href="{{ urls.build(child) }}">
                            <span class="theme-children__title">{{ child.theme.name }}</span>
                            {% if child.introText %}
                                <span class="theme-children__lede">{{ child.introText|striptags|slice(0, 110) }}…</span>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}
