{# Theme-tree children cards — args: items (list of ContentNode), urls (UrlBuilder), eyebrow, title #}
{% if items is not empty %}
    <section class="section">
        <div class="section__inner">
            <header class="section__header">
                <span class="section__eyebrow">{{ eyebrow|default('읽을거리') }}</span>
                <h2 class="section__title">{{ title|default('이 카테고리의 페이지') }}</h2>
            </header>
            <ul class="theme-children">
                {% for child in items %}
                    <li class="theme-children__item">
                        <a class="theme-children__link" href="{{ urls.build(child) }}">
                            <span class="theme-children__title">{{ child.theme.name }}</span>
                            {% if child.introText %}
                                <span class="theme-children__lede">{{ child.introText|striptags|slice(0, 110) }}…</span>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}
