{# CTA 본문 렌더링 — phone/form/external/email/messenger 5종.
   args: cta — Cta 객체 (CtaResolver 출력) #}

{% if cta.type.value == 'phone' %}
    <a class="cta cta--primary" href="tel:{{ cta.payload.phone }}">{{ cta.label ?: cta.payload.phone }}</a>
    {% if cta.hint %}<p class="cta-hint">{{ cta.hint }}</p>{% endif %}

{% elseif cta.type.value == 'form' %}
    {% set form_view = cta_form_view(cta.payload.form) %}
    <div id="cta-form-{{ cta.payload.form }}" class="cta-form">
        {{ form_start(form_view, { action: path('cta_submit', { form: cta.payload.form }), attr: { novalidate: 'novalidate' } }) }}
            {{ form_row(form_view.name) }}
            {{ form_row(form_view.phone) }}
            {{ form_row(form_view.region) }}
            {{ form_row(form_view.memo) }}
            {{ form_row(form_view.hp) }}
            {{ form_row(form_view.agree) }}
            {{ form_row(form_view.submit) }}
        {{ form_end(form_view) }}
        {% if cta.hint %}<p class="cta-hint">{{ cta.hint }}</p>{% endif %}
    </div>

{% elseif cta.type.value == 'external' %}
    <a class="cta cta--primary" href="{{ cta.payload.url }}" rel="noopener" target="_blank">{{ cta.label }}</a>

{% elseif cta.type.value == 'email' %}
    <a class="cta cta--primary" href="mailto:{{ cta.payload.email }}">{{ cta.label ?: cta.payload.email }}</a>

{% elseif cta.type.value == 'messenger' %}
    <a class="cta cta--primary" href="{{ cta.payload.url }}" rel="noopener" target="_blank">{{ cta.label }}</a>
{% endif %}
