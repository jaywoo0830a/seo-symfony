{# 단일 버튼 형태의 CTA. hero / navbar / footer에서 사용.
   args:
     cta     — Cta 객체 (CtaResolver 출력)
     variant — 'primary' | 'navbar' | 'footer' (CSS 변종)

   form 타입은 페이지 안의 '#cta-form-{name}' 앵커로 스크롤 (블록은 final_cta가 렌더).
   form 슬롯에서 button 모드를 쓰는데 페이지에 form 블록이 없으면 #cta-form-X가 없어
   anchor가 깨지므로, 그땐 그냥 글로벌 phone으로 fallback 하는 편이 안전.
#}
{% set variant = variant ?? 'primary' %}

{% if cta.type.value == 'phone' %}
    {% if variant == 'navbar' %}
        <a class="phone-bar__cta" href="tel:{{ cta.payload.phone }}">
            <span class="phone-bar__cta-icon" aria-hidden="true">📞</span>
            <span>{{ cta.payload.phone }}</span>
        </a>
    {% elseif variant == 'footer' %}
        <a class="site-foot__phone" href="tel:{{ cta.payload.phone }}">{{ cta.payload.phone }}</a>
    {% else %}
        <a class="cta cta--primary cta--lg" href="tel:{{ cta.payload.phone }}">
            <span class="cta__icon" aria-hidden="true">📞</span>
            <span>{{ cta.label ?: (cta.payload.phone ~ ' 지금 전화하기') }}</span>
        </a>
    {% endif %}

{% elseif cta.type.value == 'form' %}
    {% if variant == 'navbar' %}
        <a class="phone-bar__cta" href="#cta-form-{{ cta.payload.form }}">
            <span class="phone-bar__cta-icon" aria-hidden="true">✉️</span>
            <span>{{ cta.label }}</span>
        </a>
    {% else %}
        <a class="cta cta--primary cta--lg" href="#cta-form-{{ cta.payload.form }}">
            <span class="cta__icon" aria-hidden="true">✉️</span>
            <span>{{ cta.label }}</span>
        </a>
    {% endif %}

{% elseif cta.type.value == 'external' %}
    <a class="cta cta--primary cta--lg" href="{{ cta.payload.url }}" rel="noopener" target="_blank">
        <span>{{ cta.label }}</span>
    </a>

{% elseif cta.type.value == 'email' %}
    <a class="cta cta--primary cta--lg" href="mailto:{{ cta.payload.email }}">
        <span class="cta__icon" aria-hidden="true">✉️</span>
        <span>{{ cta.label ?: cta.payload.email }}</span>
    </a>

{% elseif cta.type.value == 'messenger' %}
    <a class="cta cta--primary cta--lg" href="{{ cta.payload.url }}" rel="noopener" target="_blank">
        <span class="cta__icon" aria-hidden="true">💬</span>
        <span>{{ cta.label }}</span>
    </a>
{% endif %}
