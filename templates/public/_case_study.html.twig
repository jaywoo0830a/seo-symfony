{# CaseStudy — BodyTemplate::CaseStudy. 미니멀 사례 연구 prose. #}

<main class="page page--narrow">
    {% include 'public/_partials/hierarchy/breadcrumb.html.twig' with { crumbs: crumbs } only %}

    <article class="article">
        <header class="article__header">
            <h1>{{ h1 }}</h1>
            {% if node.introText %}<p class="article__lede">{{ node.introText }}</p>{% endif %}
            {% if node.author %}
                <p class="article__byline">
                    <strong>{{ node.author.realName }}</strong>
                    {% if node.lastReviewAt %} · {{ node.lastReviewAt|date('Y-m-d') }}{% endif %}
                </p>
            {% endif %}
        </header>

        {% if body_html %}<div class="article__body">{{ body_html|raw }}</div>{% endif %}

        {% include 'public/_partials/hierarchy/siblings_list.html.twig' with {
            node: node,
            axis: 'theme',
            heading: '다른 사례',
        } only %}
    </article>
</main>
