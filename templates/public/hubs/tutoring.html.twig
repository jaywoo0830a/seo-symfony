{# 과외 허브 — 슬러그별 오버라이드 데모.
   이 파일이 존재하면 PublicNodeController가 기본 매트릭스 렌더 대신 이걸 씁니다.
   파셜은 자유롭게 가져다 쓰되, 순서·문구·신규 섹션은 마음대로.

   사용 가능한 컨텍스트:
     node, h1, template, byKind (quantitative/qualitative/comparison/case/faq),
     theme_children, theme_siblings, children, siblings, parent,
     urls (UrlBuilder), crumbs, region_label, theme_label, keyword
#}

{% include 'public/_partials/breadcrumb.html.twig' %}

{# 매트릭스 기본 hero보다 더 wide/dramatic한 변종. 통계는 옆이 아니라 본문 아래. #}
<section class="hub-splash">
    <div class="hub-splash__inner">
        <span class="hub-splash__eyebrow">전국 과외 매칭 허브</span>
        <h1 class="hub-splash__title">
            아이의 <span class="hub-splash__highlight">한 명의 선생님</span>을<br>
            5분 안에 찾는 가장 빠른 길.
        </h1>
        <p class="hub-splash__lede">
            {{ node.introText|default('학원에 묶이지 않고, 학년·과목·예산에 맞춘 1:1 강사를 한 통의 전화로 추천드립니다. 첫 수업이 맞지 않으면 비용은 0원입니다.') }}
        </p>
        <a class="cta cta--primary cta--lg" href="{{ brand_phone_link() }}">
            <span class="cta__icon" aria-hidden="true">📞</span>
            <span>{{ brand_phone() }} 지금 전화하기</span>
        </a>

        {% if byKind.quantitative is not empty %}
            <div class="hub-splash__stats">
                {% for dp in byKind.quantitative|slice(0, 3) %}
                    <div class="hub-splash__stat">
                        <strong class="hub-splash__stat-figure">
                            {%- if dp.value is iterable %}{{ dp.value|length }}{% else %}{{ dp.value }}{% endif -%}
                        </strong>
                        <span class="hub-splash__stat-label">{{ dp.title }}</span>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

{# 과외 전용 가치 제안 — 기본 feature_grid를 그대로 쓰되 카피만 다르게 #}
{% include 'public/_partials/feature_grid.html.twig' with {
    eyebrow: '과외만의 차이',
    title: '학원이 못 하는 것',
    lede: '한 반에 묶이지 않고 학생 한 명을 위해 설계된 수업.',
    features: [
        {icon: '🎯', title: '학생 한 명만의 진도', body: '반 평균이 아니라 *내 아이*의 현재 위치에서 시작합니다. 막히는 지점에 정확히 손을 댑니다.'},
        {icon: '📅', title: '시간·공간 자유', body: '학원 시간표가 아니라 가족 일정에 맞춥니다. 평일 저녁·주말·재택 모두 가능.'},
        {icon: '🤝', title: '선생님과 직접 신뢰', body: '학원 행정이 아니라 한 사람과 이어집니다. 학습 외 고민도 같은 사람에게.'},
    ],
} only %}

{# 시도별 매트릭스로 가는 강한 안내 — 허브의 핵심 임무 #}
<section class="hub-pivot">
    <div class="hub-pivot__inner">
        <span class="hub-pivot__eyebrow">지역으로 좁혀보기</span>
        <h2 class="hub-pivot__title">우리 동네 과외부터 살펴보세요</h2>
        <p class="hub-pivot__lede">전국 17개 시도 → 228개 시군구 단위로 평균 시급, 매칭 가능 강사 수, 인기 과목을 확인할 수 있습니다.</p>
        {% if children is not empty %}
            <ul class="hub-pivot__sidos">
                {% for sido in children %}
                    <li>
                        <a class="hub-pivot__sido-link" href="{{ urls.build(sido) }}">
                            <span class="hub-pivot__sido-name">{{ sido.region.name }}</span>
                            {% if sido.dataCount %}
                                <span class="hub-pivot__sido-meta">DataPoint {{ sido.dataCount }}개</span>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>

{# 비교·FAQ는 기본 파셜 그대로 — 일관성 유지 #}
