{# /academy/ 허브 오버라이드 — 매트릭스 톤(matrix/academy)과도 다른 *허브 전용* 셸.

   tutoring 허브가 "splash + 행동 유도"라면, academy 허브는 "디렉토리 + 비교 안내".
   대형 검색바 모양·지역 타일·기관 신뢰 문구로 정보 탐색 모드를 강조.
#}

{% include 'public/_partials/breadcrumb.html.twig' %}

<section class="hub-directory">
    <div class="hub-directory__inner">
        <span class="hub-directory__eyebrow">전국 학원 정보 디렉토리</span>
        <h1 class="hub-directory__title">{{ theme_label }}, 한 페이지에서 비교</h1>
        <p class="hub-directory__lede">
            {{ node.introText|default('지역·과목·수강료·시간표를 운영팀이 검증한 학원 정보. 방문 전 통화 한 번으로 비교 가능.') }}
        </p>

        {# 검색바 모양 (실제 폼은 추후) — 정보 탐색 의도를 시각적으로 표현 #}
        <div class="hub-directory__search">
            <span class="hub-directory__search-icon" aria-hidden="true">🔍</span>
            <span class="hub-directory__search-text">전화로 지역·과목 알려주시면 학원 후보 안내</span>
            <a class="hub-directory__search-cta" href="{{ brand_phone_link() }}">{{ brand_phone() }}</a>
        </div>
    </div>
</section>

{# 시도 타일 그리드 — children = sido 노드들 #}
{% if children is not empty %}
    <section class="hub-directory__regions">
        <div class="section__inner">
            <header class="section__header">
                <span class="section__eyebrow">지역으로 둘러보기</span>
                <h2 class="section__title">시도별 학원 정보</h2>
            </header>
            <ul class="hub-directory__tiles">
                {% for sido in children %}
                    <li>
                        <a class="hub-directory__tile" href="{{ urls.build(sido) }}">
                            <span class="hub-directory__tile-name">{{ sido.region.name }}</span>
                            {% if sido.dataCount %}
                                <span class="hub-directory__tile-meta">{{ sido.dataCount }}개 데이터 항목</span>
                            {% endif %}
                            <span class="hub-directory__tile-arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}

{# 학원 신뢰 시그널 — 과외 hub와 다른 메시지 #}
