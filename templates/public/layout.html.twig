<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    <meta name="description" content="{% block description %}{% endblock %}">
    {% block canonical %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('styles/brand.css') }}">
</head>
<body>
    <header class="site-head">
        <a class="site-head__brand" href="{{ path('public_home') }}">{{ brand_public_name() }}</a>
        <nav class="site-head__nav">
            {% for theme in top_themes() %}
                <a class="site-head__nav-link" href="/{{ theme.slug }}/">{{ theme.name }}</a>
            {% endfor %}
        </nav>
    </header>

    {% block content %}{% endblock %}

    <footer class="site-foot">
        <span>© {{ brand_public_name() }}</span>
        <a class="site-foot__link" href="{{ path('public_sitemap') }}">sitemap</a>
    </footer>
</body>
</html>
