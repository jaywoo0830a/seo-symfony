{# 제네릭 매트릭스 fallback — matrix/{theme-slug}.html.twig 가 없을 때.
   *블랭크 스타터*용 최소 마크업. 도메인에 맞춰 자유롭게 덮어쓰세요. #}

<main class="page page--narrow">
    {% if crumbs is not empty %}
        <nav class="crumbs" aria-label="Breadcrumb">
            {% for crumb in crumbs %}
                {% if crumb.current %}
                    <span class="crumbs__current" aria-current="page">{{ crumb.label }}</span>
                {% else %}
                    <a class="crumbs__link" href="{{ crumb.url }}">{{ crumb.label }}</a>
                    <span class="crumbs__sep" aria-hidden="true">›</span>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}

    <h1>{{ keyword }}</h1>
    {% if node.introText %}<p class="lede">{{ node.introText }}</p>{% endif %}

    {% for kind, points in byKind %}
        {% if points is not empty %}
            <section>
                <h2>{{ kind }}</h2>
                <ul class="data-list">
                    {% for dp in points %}
                        <li class="data-list__item">
                            <span class="data-list__key">{{ dp.title }}</span>
                            {% include 'public/_value.html.twig' with { value: dp.value } only %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endfor %}

    {% if theme_children is not empty %}
        <section>
            <h2>{{ theme_label }} 하위 페이지</h2>
            <ul class="link-list">
                {% for child in theme_children %}
                    <li class="link-list__item">
                        <a class="link-list__link" href="{{ urls.build(child) }}">{{ child.theme.name }}</a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% set _final_cta = cta('final', template) %}
    {% if _final_cta %}
        <section class="cta-block">
            {% include 'public/_partials/cta/_block_body.html.twig' with { cta: _final_cta } only %}
        </section>
    {% endif %}
</main>
