{# 제네릭 매트릭스 fallback — matrix/{theme-slug}.html.twig 가 없을 때.
   *블랭크 스타터*용 최소 마크업. 도메인에 맞춰 자유롭게 덮어쓰세요.

   계층 표현은 _partials/hierarchy/* 파셜을 조합. nav/urls는 Twig 글로벌. #}

<main class="page page--narrow">
    {% include 'public/_partials/hierarchy/breadcrumb.html.twig' with { crumbs: crumbs } only %}

    <h1>{{ keyword }}</h1>
    {% if node.introText %}<p class="lede">{{ node.introText }}</p>{% endif %}

    {% for kind, points in byKind %}
        {% if points is not empty %}
            <section>
                <h2>{{ kind }}</h2>
                <ul class="data-list">
                    {% for dp in points %}
                        <li class="data-list__item">
                            <span class="data-list__key">{{ dp.title }}</span>
                            {% include 'public/_value.html.twig' with { value: dp.value } only %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endfor %}

    {% include 'public/_partials/hierarchy/children_grid.html.twig' with {
        node: node,
        axis: 'theme',
        heading: theme_label ~ ' 하위 페이지',
    } only %}

    {% set _final_cta = cta('final', template) %}
    {% if _final_cta %}
        <section class="cta-block">
            {% include 'public/_partials/cta/_block_body.html.twig' with { cta: _final_cta } only %}
        </section>
    {% endif %}
</main>
