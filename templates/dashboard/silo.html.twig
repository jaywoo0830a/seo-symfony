{% extends 'dashboard/layout.html.twig' %}

{% block title %}무결성 · {{ parent() }}{% endblock %}

{% block content %}
    <div class="dashboard">
        <header class="dashboard__header">
            <h1 class="dashboard__title">무결성</h1>
            <p class="dashboard__subtitle">현재 적재된 참조 데이터의 카운트입니다.</p>
        </header>

        <section class="dashboard__section">
            <div class="panel">
                <ul class="list">
                    {% for check in checks %}
                        <li class="list__row">
                            <span class="list__label">{{ check.label }}</span>
                            <span class="list__value">{{ check.value }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    </div>
{% endblock %}
