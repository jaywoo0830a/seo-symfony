{% extends 'dashboard/layout.html.twig' %}

{% block title %}{{ author.realName }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="dashboard">
        <header class="dashboard__header">
            <a class="dashboard__back" href="{{ path('admin_authors') }}">← 작성자 목록</a>
            <h1 class="dashboard__title">{{ author.realName }}</h1>
            <p class="dashboard__subtitle">
                @{{ author.slug }} ·
                {% if author.verified %}
                    <span class="badge badge--verified">인증 {{ author.verifiedAt|date('Y-m-d') }}</span>
                {% else %}
                    <span class="badge badge--unverified">미인증</span>
                {% endif %}
            </p>
        </header>

        <section class="dashboard__section">
            <div class="dashboard__grid dashboard__grid--two-col">
                <div class="panel">
                    <header class="panel__header">
                        <span class="panel__title">자격·경력</span>
                    </header>
                    {% if author.credentials %}
                        <p>{{ author.credentials|nl2br }}</p>
                    {% else %}
                        <div class="empty"><span class="empty__title">미입력</span></div>
                    {% endif %}
                </div>

                <div class="panel">
                    <header class="panel__header">
                        <span class="panel__title">소개</span>
                    </header>
                    {% if author.bio %}
                        <p>{{ author.bio|nl2br }}</p>
                    {% else %}
                        <div class="empty"><span class="empty__title">미입력</span></div>
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="dashboard__section">
            <div class="panel">
                <ul class="list">
                    <li class="list__row">
                        <span class="list__label">작성한 콘텐츠 노드</span>
                        <span class="list__value">{{ nodeCount }}</span>
                    </li>
                    {% if author.photoUrl %}
                        <li class="list__row">
                            <span class="list__label">사진 URL</span>
                            <span class="list__value"><a href="{{ author.photoUrl }}">{{ author.photoUrl }}</a></span>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </section>

        <section class="dashboard__section">
            <div class="form__actions">
                <a class="button button--primary" href="{{ path('admin_authors_edit', {id: author.id}) }}">편집</a>
                <form method="post" action="{{ path('admin_authors_verify', {id: author.id}) }}" class="form__inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('verify-author-' ~ author.id) }}">
                    <button type="submit" class="button button--ghost">{{ author.verified ? '인증 해제' : '인증' }}</button>
                </form>
                <form method="post" action="{{ path('admin_authors_delete', {id: author.id}) }}" class="form__inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-author-' ~ author.id) }}">
                    <button type="submit" class="button button--danger">삭제</button>
                </form>
            </div>
        </section>
    </div>
{% endblock %}
