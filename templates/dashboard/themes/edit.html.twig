{% extends 'dashboard/layout.html.twig' %}

{% block title %}편집 · {{ parent() }}{% endblock %}

{% block content %}
    <div class="dashboard">
        <header class="dashboard__header">
            <a class="dashboard__back" href="{{ path('admin_themes_show', {id: theme.id}) }}">← {{ theme.name }}</a>
            <h1 class="dashboard__title">편집</h1>
        </header>

        {{ include('dashboard/themes/_form.html.twig', {
            submit_label: '저장',
            cancel_path: path('admin_themes_show', {id: theme.id})
        }) }}
    </div>
{% endblock %}
