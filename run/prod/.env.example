# Copy to run/prod/.env and fill in real values before running up.sh.
# This file is committed; the .env file itself must NOT be (gitignored).

# ── Symfony ──────────────────────────────────────────────────────────────────

# Generate with:  openssl rand -hex 32
APP_SECRET=change_me_to_a_long_random_hex_string

# Public origin used for absolute URLs in CLI commands (sitemap.xml, JSON-LD 등).
# Should match DOMAIN with the appropriate scheme.
DEFAULT_URI=https://example.com

# Mailer transport. null://null disables outbound email; replace for real SMTP.
MAILER_DSN=null://null

# ── PostgreSQL ───────────────────────────────────────────────────────────────

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── HTTPS / Caddy ────────────────────────────────────────────────────────────
# Public hostname Caddy will serve on.
#   • Real hostname (e.g. seo.example.com) → automatic Let's Encrypt cert.
#     DNS A/AAAA must point at this host AND ports 80+443 must be reachable
#     from the public internet for the ACME HTTP-01 challenge to succeed.
#   • "localhost"  → Caddy issues a self-signed cert from its internal CA.
#     Trust is local-only; browsers will warn unless you import Caddy's root.
DOMAIN=localhost

# Contact email for Let's Encrypt account. Optional but recommended for real
# domains — Let's Encrypt sends expiry warnings here.
ACME_EMAIL=

# Host ports. 80/443 are the defaults; change only if those are already taken.
HTTP_PORT=80
HTTPS_PORT=443

# ── Brand identity ───────────────────────────────────────────────────────────
# 사이트에 노출되는 식별값. 모두 실제 값으로 입력 — 더미 채로 배포 금지.

BRAND_ADMIN_NAME="Admin"
BRAND_PUBLIC_NAME="Your Brand"

# tel: 링크 + final CTA 에 표시되는 대표 번호.
BRAND_PHONE="010-XXXX-XXXX"

# 운영 시간. final CTA 하단 hint 에 표시.
BRAND_PHONE_HOURS="평일 09:00 – 21:00"

# ── CTA notifier (선택 — 폼 CTA 사용 시) ─────────────────────────────────────
# 폼 CTA 추가 시 아래 토큰 입력 + cta.yaml 수정.
# CTA_TELEGRAM_BOT_TOKEN=
# CTA_TELEGRAM_CHAT_ID=
# CTA_DISCORD_WEBHOOK_URL=
