# Optional. Copy to run/dev/.env to override defaults; safe to omit entirely.

# Host-side ports (change if 8080/5433/8025 collide with other tools).
HTTP_PORT=8080
POSTGRES_PORT=5433
MAILPIT_PORT=8025

# Database credentials (defaults match the existing project for convenience).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

# Symfony secret. Any non-empty string works in dev.
APP_SECRET=dev_secret_not_for_production

# Host UID/GID auto-detected via `id` in up.sh. Override only if Docker Desktop
# maps users differently. (Named HOST_UID/HOST_GID because bash treats UID/GID as readonly.)
# HOST_UID=1000
# HOST_GID=1000
