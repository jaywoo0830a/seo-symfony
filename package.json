{
    "name": "seo-symfony",
    "private": true,
    "description": "SEO 대시보드 + 브랜드 랜딩 — sass only.",
    "scripts": {
        "build": "sass assets/scss/app.scss:assets/styles/app.css assets/scss/brand/app.scss:assets/styles/brand.css --no-source-map --style=expanded",
        "watch": "sass --watch assets/scss/app.scss:assets/styles/app.css assets/scss/brand/app.scss:assets/styles/brand.css --no-source-map --style=expanded",
        "build:prod": "sass assets/scss/app.scss:assets/styles/app.css assets/scss/brand/app.scss:assets/styles/brand.css --no-source-map --style=compressed"
    }
}
